/* InfiniteRicks Android — wallettest-inspired layout, green accent #5EAE4C */

* {
    font-family: sans-serif;
}

QWidget {
    background-color: #050B13;
    color: #FFFFFF;
    font-size: 12pt;
}

QMainWindow {
    background-color: #050B13;
}

QMainWindow::separator {
    width: 0;
    height: 0;
}

QWidget#contentArea {
    background-color: #050B13;
}

QStackedWidget {
    background: transparent;
}

/* Header */
QWidget#androidHeader {
    background: transparent;
}

QLabel#androidHeaderTitle {
    color: #FFFFFF;
    font-size: 20pt;
    font-weight: 700;
    background: transparent;
}

QLabel#androidHeaderLogo {
    background: #00182A;
    border-radius: 22px;
    min-width: 44px;
    max-width: 44px;
    min-height: 44px;
    max-height: 44px;
}

/* Balance hero card (gradient painted in BalanceCardWidget) */
QFrame#balanceHeroCard {
    background: transparent;
    border: none;
    border-radius: 22px;
    padding: 4px;
}

QFrame#balanceHeroCard QLabel {
    color: #FFFFFF;
    background: transparent;
    border: none;
}

QLabel#labelBalanceCaption {
    color: rgba(255, 255, 255, 0.88);
    font-size: 12pt;
}

QLabel#labelUnitBadge {
    background-color: rgba(0, 0, 0, 0.22);
    color: #FFFFFF;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 8pt;
    font-weight: 600;
}

QLabel#labelHeroBalance {
    font-size: 30pt;
    font-weight: 700;
}

QLabel#labelBalanceChange {
    background-color: rgba(255, 255, 255, 0.14);
    color: #E8FFE3;
    border-radius: 14px;
    padding: 6px 14px;
    font-size: 11pt;
}

QPushButton#heroSettingsButton {
    background: rgba(255, 255, 255, 0.14);
    border: none;
    border-radius: 22px;
    min-width: 44px;
    max-width: 44px;
    min-height: 44px;
    max-height: 44px;
    padding: 0;
    color: #FFFFFF;
}

QPushButton#heroSettingsButton:pressed {
    background: rgba(255, 255, 255, 0.24);
}

/* Quick actions */
QWidget#quickActionsRow {
    background: transparent;
}

QToolButton#quickActionSend {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #F68B35, stop:1 #E63946);
    border: none;
    border-radius: 24px;
    padding: 18px 10px 14px 10px;
    color: #FFFFFF;
    font-size: 11pt;
    font-weight: 700;
    min-height: 88px;
}

QToolButton#quickActionSend:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #E07A2E, stop:1 #CC3340);
}

QToolButton#quickActionReceive {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #4D9A3E, stop:1 #5EAE4C);
    border: none;
    border-radius: 24px;
    padding: 18px 10px 14px 10px;
    color: #FFFFFF;
    font-size: 11pt;
    font-weight: 700;
    min-height: 88px;
}

QToolButton#quickActionReceive:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #3D7A32, stop:1 #4D9A3E);
}

QToolButton#quickActionHistory,
QToolButton#quickActionMore {
    background: #00182A;
    border: 1px solid #0F2A3D;
    border-radius: 22px;
    padding: 16px 8px 12px 8px;
    color: #FFFFFF;
    font-size: 11pt;
    font-weight: 600;
    min-height: 88px;
}

QToolButton#quickActionHistory:pressed,
QToolButton#quickActionMore:pressed {
    background: #0F2A3D;
}

/* Assets / activity card */
QFrame#walletDetailsCard, QFrame#assetsCard {
    background-color: #00182A;
    border: 1px solid #0F2A3D;
    border-radius: 18px;
}

QFrame#frameSync {
    background-color: #00182A;
    border: 1px solid #5EAE4C;
    border-radius: 14px;
}

QLabel#assetsSectionTitle {
    font-size: 14pt;
    font-weight: 700;
    color: #FFFFFF;
    background: transparent;
}

QLabel#assetsFilterLabel {
    color: #5EAE4C;
    font-weight: 600;
    background: transparent;
}

QLabel#labelWalletStatus, QLabel#labelTransactionsStatus {
    color: #F59E0B;
    font-weight: normal;
    background: transparent;
}

QLabel#labelSyncStatus {
    color: #5EAE4C;
    background: transparent;
}

QListView#listTransactions {
    background: transparent;
    border: none;
    outline: none;
}

QListView#listTransactions::item {
    background: #0F2A3D;
    border-radius: 14px;
    padding: 8px;
    margin-bottom: 8px;
}

QListView#listTransactions::item:selected {
    background: #1A3A52;
}

QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: #00182A;
    border: 1px solid #0F2A3D;
    border-radius: 12px;
    padding: 10px 12px;
    color: #FFFFFF;
    min-height: 1.4em;
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, QSpinBox:focus,
QDoubleSpinBox:focus, QComboBox:focus {
    border-color: #5EAE4C;
}

QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #0F2A3D, stop:1 #00182A);
    border: 1px solid #1A3A52;
    border-radius: 16px;
    padding: 14px 22px;
    color: #FFFFFF;
    font-size: 12pt;
    font-weight: 600;
    min-height: 48px;
}

QPushButton:pressed {
    background: #1A3A52;
    border-color: #5EAE4C;
}

QPushButton:default {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #4D9A3E, stop:1 #5EAE4C);
    border: none;
    color: #FFFFFF;
    font-weight: 700;
}

QTableView, QListView, QTreeView {
    background: #00182A;
    border: 1px solid #0F2A3D;
    border-radius: 14px;
    alternate-background-color: #0F2A3D;
    gridline-color: #050B13;
    selection-background-color: #2D4A28;
    selection-color: #FFFFFF;
}

QHeaderView::section {
    background: #0F2A3D;
    border: none;
    border-bottom: 1px solid #050B13;
    padding: 8px;
    color: #768090;
    font-weight: 600;
}

QTabWidget::pane {
    border: 1px solid #0F2A3D;
    border-radius: 14px;
    background: #00182A;
}

QTabBar::tab {
    background: #0F2A3D;
    border: 1px solid #1A3A52;
    border-bottom: none;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    padding: 8px 14px;
    color: #768090;
}

QTabBar::tab:selected {
    background: #00182A;
    color: #5EAE4C;
}

QProgressBar {
    border: 1px solid #0F2A3D;
    border-radius: 8px;
    background: #00182A;
    text-align: center;
    color: #FFFFFF;
    max-height: 18px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #4D9A3E, stop:1 #5EAE4C);
    border-radius: 7px;
}

QStatusBar {
    background: #050B13;
    border-top: 1px solid #00182A;
    color: #768090;
}

QMenuBar {
    background: #050B13;
    color: #FFFFFF;
}

QDialog {
    background: #050B13;
}

/* Bottom navigation */
QWidget#androidBottomNav {
    background-color: #00182A;
    border-top: 1px solid #050B13;
    min-height: 76px;
    max-height: 76px;
}

QToolButton#androidNavButton {
    background: transparent;
    border: none;
    border-radius: 14px;
    padding: 8px 6px;
    color: #768090;
    font-size: 10pt;
    font-weight: 600;
    min-height: 64px;
}

QToolButton#androidNavButton:checked {
    color: #5EAE4C;
    background: rgba(94, 174, 76, 0.14);
}

QToolButton#androidNavButton:pressed {
    background: rgba(94, 174, 76, 0.22);
}
